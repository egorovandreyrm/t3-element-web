.mx_MStreamBody {
    margin-top: 8px;
    box-sizing: border-box;
    padding: 12px;
    border: 1px solid $quinary-content;
    border-radius: 8px;
    background-color: $background;
    border-color: var(--cpd-color-border-interactive-hovered);

    h4 {
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-15px;
        line-height: $font-24px;
        margin-top: 0;
        margin-bottom: 8px;

        .mx_MStreamBody_edited {
            color: $roomtopic-color;
            font-size: $font-12px;
            opacity: 0.6;
        }
    }

    h4::before {
        content: "";
        position: relative;
        display: inline-block;
        margin-right: 12px;
        top: 3px;
        left: 3px;
        height: 20px;
        width: 20px;
        background-color: $secondary-content;
        mask-repeat: no-repeat;
        mask-size: contain;
        mask-position: center;
        mask-image: url("$(res)/img/stream/ic_stream.svg");

        //.mx_MStreamBody_inprogress {
        //    mask-image: url("$(res)/img/stream/ic_stream.svg");
        //}
        //
        //.mx_MStreamBody_ended {
        //    mask-image: url("$(res)/img/stream/ic_stream_ended.svg");
        //}
    }
}
